generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        String     @id @default(uuid())
  nombre    String
  icono     String
  url       String
  tarjetas  Tarjeta[]
  servicios Servicio[]
}

model Tarjeta {
  id          String  @id @default(uuid())
  nombre      String
  monto       Float
  vencimiento String
  empresa     Empresa @relation(fields: [empresaId], references: [id])
  empresaId   String
  cuotas      Cuota[]
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId   String
}

model Cuota {
  id          String  @id @default(uuid())
  nombre      String
  cuotaActual Int
  cuotaBase   Int
  cuotaTotal  Int
  monto       Float
  fechaCarga  String
  tarjeta     Tarjeta @relation(fields: [tarjetaId], references: [id])
  tarjetaId   String
}

model Servicio {
  id          String  @id @default(uuid())
  nombre      String
  monto       Float
  vencimiento String
  empresa     Empresa @relation(fields: [empresaId], references: [id])
  empresaId   String
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId   String
  etiqueta1   EtiquetaCredencial?
  valor1      String?
  etiqueta2   EtiquetaCredencial?
  valor2      String?
}

model Usuario {
  id          String @id @default(uuid())
  nombre      String
  email       String @unique
  password    String
  tarjetas  Tarjeta[]
  servicios Servicio[]
}

enum EtiquetaCredencial {
  NUMERO_CLIENTE
  NUMERO_CONTRATO
  NUMERO_CUENTA
  UF
  NUMERO
  IDENTIFICADOR
}
